# ==============================================================================
# SMART MESS MANAGEMENT & AUTOMATION SYSTEM — ENVIRONMENT CONFIGURATION
# ==============================================================================
# Copy this file to .env.local and populate the values.
# NEVER commit your actual .env or .env.local file to version control.
# ==============================================================================

# Browser-Safe Supabase Configuration (Public)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-supabase-publishable-key
# Legacy fallback (if your project uses anon key):
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key

# Server-Only Supabase Configuration (NEVER expose to browser/client-side)
SUPABASE_SECRET_KEY=your-supabase-secret-key
# Legacy fallback (if your project uses service role key):
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# Admin Bootstrap Configuration (Server-Only comma-separated emails)
# Pre-authorized university emails that are granted ADMIN role
ADMIN_EMAILS=admin@uohyd.ac.in,messadmin@uohyd.ac.in

# Application Base URL
NEXT_PUBLIC_APP_URL=http://localhost:3000
